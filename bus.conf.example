# 버스 도착 정보 설정 예시
#
#   cp bus.conf.example bus.conf
#   (SERVICE_KEY 를 채운 뒤) chmod 644 bus.conf
#
# bus.conf 는 .gitignore 에 들어 있습니다. 인증키가 들어 있으니 절대 커밋하지 마세요.
# 시계는 bus.conf 가 생기면 30초 안에 알아서 버스 정보를 받기 시작하고,
# 지우면 원래 시계 화면(HH:MM:SS)으로 돌아갑니다. 재시작은 필요 없습니다.

# 공공데이터포털(data.go.kr) 일반 인증키 (Encoding / Decoding 어느 쪽이든 가능)
# 활용신청: 대전광역시_정류소별 도착정보 조회(기본), 국토교통부_(TAGO)_버스도착정보(예비)
SERVICE_KEY=

# 아래는 기본값입니다. 바꿀 때만 주석(#)을 지우세요.
# 한밭대학교 정류장, 대전역동광장 방향(102번 기준)
# 앞의 API가 실패할 때만 다음 API를 씁니다.
#PROVIDERS=daejeon,tago
#CITY_CODE=25
#NODE_ID=DJB8002920
#BUS_STOP_ID=8002920
#TIMEOUT=8

# 정류장의 모든 노선을 받아 옵니다. 화면에 어떻게 보여 줄지는 ./clockmode 로 바꿉니다.
#   ./clockmode 1   시계 <-> 전체 버스 화면 번갈아 보기
#   ./clockmode 2   오른쪽 버스 정보를 노선별로 순환 (기본)
#   ./clockmode 3   한 노선만 고정 (./clockmode 3 --route 102)
#   ./clockmode 0   원래 시계만 (API 호출 없음)
